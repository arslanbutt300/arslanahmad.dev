---
// Full-service IT offering, grouped by category.
// Each category has its own accent token so the section stays theme-reactive.
const categories = [
  {
    label: 'Development',
    accent: 'var(--brand-1)',
    services: [
      { icon: '📱', title: 'Mobile App Development', desc: 'Native iOS & Android apps plus cross-platform builds — from architecture to App Store and Play Store launch.', tags: ['iOS', 'Android', 'Flutter'] },
      { icon: '🌐', title: 'Web Development', desc: 'Fast, modern websites and web apps — marketing sites, dashboards, and full-stack platforms that scale.', tags: ['React', 'Astro', 'Node'] },
      { icon: '🖥️', title: 'Desktop Applications', desc: 'Cross-platform desktop software for macOS, Windows, and Linux with native-grade performance.', tags: ['macOS', 'Windows', 'Linux'] },
      { icon: '⚙️', title: 'Custom Software', desc: 'Tailored software, APIs, and automation built around your exact workflow — no off-the-shelf compromises.', tags: ['APIs', 'SaaS', 'Automation'] },
    ],
  },
  {
    label: 'Emerging Tech',
    accent: 'var(--brand-bond)',
    services: [
      { icon: '🤖', title: 'AI & Machine Learning', desc: 'AI-powered features, LLM integrations, chatbots, and intelligent automation built on modern models.', tags: ['LLMs', 'Claude API', 'RAG'] },
      { icon: '📡', title: 'IoT & Connected Devices', desc: 'Smart device integration, embedded firmware, and real-time data pipelines for connected products.', tags: ['Embedded', 'MQTT', 'Sensors'] },
    ],
  },
  {
    label: 'Creative',
    accent: 'var(--brand-2)',
    services: [
      { icon: '🎨', title: 'Design — UI/UX & Graphics', desc: 'Product UI/UX, brand identity, and graphic design that makes your product look as good as it works.', tags: ['Figma', 'UI/UX', 'Branding'] },
      { icon: '📣', title: 'Social Media Management', desc: 'Content strategy, creation, and end-to-end account management to grow your brand across platforms.', tags: ['Content', 'Strategy', 'Growth'] },
    ],
  },
  {
    label: 'Engineering',
    accent: 'var(--brand-2)',
    services: [
      { icon: '🧱', title: 'Structural QC Inspection', desc: 'On-site quality control, materials testing, and compliance reporting for precast and structural projects.', tags: ['QC', 'Materials', 'Compliance'] },
    ],
  },
];
---

<section id="services" style="padding: 120px 48px; border-top: 1px solid var(--border-1);">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div class="reveal" style="margin-bottom: 56px; max-width: 760px;">
      <div style="font-size: 11px; color: var(--brand-1); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 12px; font-weight: 600;">
        Services
      </div>
      <h2 style="font-size: clamp(36px, 5vw, 56px); font-family: 'Space Grotesk', sans-serif; letter-spacing: -2px;">
        Everything your product needs, <span class="gradient-text-2">under one roof.</span>
      </h2>
      <p style="color: var(--text-2); font-size: 16px; margin-top: 14px; line-height: 1.7;">
        A full-service IT team led by two brothers — engineering, AI, design, and quality, delivered end to end.
        Whatever you're building, we take it from idea to launch.
      </p>
    </div>

    <div class="services-grid">
      {categories.map((cat) => (
        <>
          <div class="reveal service-cat-head" style="grid-column: 1 / -1;">
            <span class="service-cat-dot" style={`background: ${cat.accent}; box-shadow: 0 0 12px ${cat.accent};`}></span>
            <span class="service-cat-label" style={`color: ${cat.accent};`}>{cat.label}</span>
            <span class="service-cat-line" style={`background: linear-gradient(90deg, color-mix(in srgb, ${cat.accent} 40%, transparent), transparent);`}></span>
          </div>
          {cat.services.map((s) => (
            <div class="glass tilt-card reveal-scale service-card" style="border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden;">
              <div style={`position: absolute; top: -30px; right: -30px; width: 150px; height: 150px; background: radial-gradient(circle, color-mix(in srgb, ${cat.accent} 22%, transparent) 0%, transparent 70%); filter: blur(25px);`}></div>
              <div style="position: relative;">
                <div style="font-size: 32px; margin-bottom: 14px;">{s.icon}</div>
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 10px; font-family: 'Space Grotesk', sans-serif;">{s.title}</h3>
                <p style="font-size: 13px; color: var(--text-2); line-height: 1.7; margin-bottom: 16px;">{s.desc}</p>
                <div style="display: flex; flex-wrap: wrap; gap: 5px;">
                  {s.tags.map(t => (
                    <span style={`background: color-mix(in srgb, ${cat.accent} 10%, transparent); border: 1px solid color-mix(in srgb, ${cat.accent} 25%, transparent); color: ${cat.accent}; border-radius: 4px; padding: 3px 9px; font-size: 11px; font-weight: 500;`}>{t}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </>
      ))}
    </div>

    <div class="reveal" style="text-align: center; margin-top: 64px;">
      <a href="/#contact" class="btn-primary">
        Let's build something together →
      </a>
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .service-card { height: 100%; }

  .service-cat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    margin-bottom: 4px;
  }
  .service-cat-head:first-child { margin-top: 0; }
  .service-cat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .service-cat-label {
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-weight: 700;
    font-family: 'Space Grotesk', sans-serif;
  }
  .service-cat-line {
    flex: 1;
    height: 1px;
  }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #services { padding: 90px 24px !important; }
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
