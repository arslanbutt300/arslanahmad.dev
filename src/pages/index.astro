---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Brain & Bricks — Arslan Ahmad & Muhammad Bilal"
  description="Brain & Bricks — a full-service IT studio led by Arslan Ahmad & Muhammad Bilal. Mobile & web apps, desktop software, AI, IoT, design, social media, and structural QC — from idea to launch."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Brain & Bricks",
      "url": "https://brainandbricks.com",
      "logo": "https://brainandbricks.com/favicon.svg",
      "description": "A full-service IT studio led by Arslan Ahmad and Muhammad Bilal. Mobile, web, and desktop app development, AI, IoT, design, social media management, and structural QC inspection.",
      "founders": [
        {
          "@type": "Person",
          "name": "Arslan Ahmad",
          "jobTitle": "Principal iOS Engineer",
          "url": "https://brainandbricks.com/arslan"
        },
        {
          "@type": "Person",
          "name": "Muhammad Bilal",
          "jobTitle": "Sr Quality Inspector",
          "url": "https://brainandbricks.com/bilal"
        }
      ],
      "sameAs": [
        "https://github.com/arslanbutt300",
        "https://www.linkedin.com/in/arslanahmaddev"
      ],
      "makesOffer": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development", "description": "Native iOS & Android apps and cross-platform builds." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Development", "description": "Websites and web apps — marketing sites, dashboards, and full-stack platforms." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desktop Applications", "description": "Cross-platform desktop software for macOS, Windows, and Linux." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Software", "description": "Tailored software, APIs, and automation." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI & Machine Learning", "description": "AI features, LLM integrations, chatbots, and intelligent automation." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "IoT & Connected Devices", "description": "Smart device integration, embedded firmware, and real-time data pipelines." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "UI/UX & Graphic Design", "description": "Product UI/UX, brand identity, and graphic design." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Management", "description": "Content strategy, creation, and account management." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Structural QC Inspection", "description": "On-site quality control, materials testing, and compliance reporting." } }
      ]
    })} />
  </Fragment>
  <Nav />
  <main>
    <Hero />
    <About />
    <Projects />
    <BlogPreview />
    <Services />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
